{
  "name": "tccg-work",
  "version": "1.1.1",
  "description": "TC Construction Group commercial building modernization and project operations platform",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "generate:brand-assets": "node scripts/generate-brand-assets.mjs",
    "generate:marketing-assets": "node scripts/generate-marketing-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm build",
    "production:verify": "node scripts/verify-production.mjs",
    "audit:prod": "pnpm audit --prod --audit-level=moderate"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.37.3",
    "@tailwindcss/typography": "^0.5.19",
    "clsx": "^2.1.1",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.15.1"
  },
  "packageManager": "pnpm@11.15.1"
}
