# Public application
NEXT_PUBLIC_SITE_URL="https://tccg.work"

# Protected operations and capture workspaces
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Public project-intake delivery
# Must be an HTTPS endpoint owned by an approved CRM, Jobber, automation, or Tolani HQ intake service.
TCCG_INTAKE_WEBHOOK_URL=""
TCCG_INTAKE_WEBHOOK_SECRET=""

# Protected capture-source configuration
SAM_GOV_API_KEY=""
CANDID_API_KEY=""
CAPTURE_KEYWORDS="smart HVAC,HVAC controls,building automation,energy efficiency retrofit,indoor air quality,construction workforce,BIM,green building"
CAPTURE_SOURCE_LIMIT="5"

# Multi-document preconstruction intake (server-only; do not set NEXT_PUBLIC_)
# Required for /api/intake/documents; point to private Cloudflare Worker /v1/intake/documents
TCCG_DOCUMENT_INGEST_URL=""
TCCG_DOCUMENT_INGEST_SECRET=""

# Private Cloudflare Worker bindings (configure via Wrangler, NOT Next.js .env)
# INTAKE_DB = D1 binding; INTAKE_DOCUMENTS = private R2 bucket binding
# TCCG_DOCUMENT_INGEST_SECRET = matching server-only secret
# ENTERPRISE_SYNC_URL = approved enterprise ingestion endpoint
# ENTERPRISE_SYNC_SECRET = HMAC secret for outbox delivery
